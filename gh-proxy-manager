#!/bin/bash
# gh-proxy-manager —— GitHub 下载加速代理管理器  v2.3.1（jsdelivr CDN 加速）
# 界面: yad 单窗口；提权一次授权；含备选代理管理(添加/删除/变更代理)
# v1.4.0: 严格表单解析(URL 正则提取兜底)、入库清洗、全路径调试日志
# v2.3.0: raw.githubusercontent.com 可选用 jsdelivr CDN 加速（复选框）
# v2.3.1: 已带加速前缀的链接（https://proxy/https://github.com/...）原样透传，不再二次拼接
# v2.3.2: 连通性测试改为 release 文件真实测速（旧版只测 raw README，测不出站对 release 的 404/限速）
# v2.3.3: curl-gh 自动换站——下载失败或龟速(<20KB/s 持续30s)时按备选列表断点续传换下一站，
#         公益站速度波动大，手选"最快站"的快照几分钟就过期，自动 failover 才是根治
# v2.3.4: 自动换站可开关（GUI/CLI），/etc/gh-proxy/nofailover 存在=禁用（默认启用）
# v2.3.4 关键修复: curl-gh 一直用 $1 当 URL，但 makepkg 的 DLAGENT 模板 %u 在末尾、
#         URL 实为最后一个参数 → 代理改写从未生效，github 下载一直直连（慢的总根源）
# v2.3.5: 修复 zenity 后备界面闪退——zenity 4.x 的 --forms 无 --add-checkbox（rc=255），
#         旧代码把 stderr 丢弃 + 静默退出，导致"有 zenity 无 yad"的用户点开即闪退；
#         改用 --add-combo 模拟开关，失败时记日志并给出可执行的提示

set -u

CONF_DIR="/etc/gh-proxy"
PREFIX_FILE="$CONF_DIR/prefix"
DLAGENT_CONF="/etc/makepkg.conf.d/99-gh-proxy.conf"
CURL_GH="/usr/local/bin/curl-gh"
GIT_URL_KEY_HOST="https://github.com/"
DEFAULT_PREFIX="https://ghfile.geekertao.top/"
JSD_FILE="$CONF_DIR/jsdelivr"   # 存在=raw.githubusercontent.com 走 jsdelivr CDN
NOFO_FILE="$CONF_DIR/nofailover"  # 存在=禁用自动换站（failover 默认启用）

LIST_DIR="$HOME/.config/gh-proxy-manager"
LIST_FILE="$LIST_DIR/proxies"
LOG_FILE="$LIST_DIR/debug.log"

have() { command -v "$1" >/dev/null 2>&1; }
dlog() { mkdir -p "$LIST_DIR"; printf '[%s] %s\n' "$(date +%T)" "$*" >>"$LOG_FILE"; }

# ---------- 提权 ----------
SUDO_PASS=""
trap '[ -n "${SUDO_PASS:-}" ] && unset SUDO_PASS' EXIT

ask_password() {
    [ "$(id -u)" = 0 ] && return 0
    sudo -n true 2>/dev/null && return 0
    local pass=""
    if have yad; then
        pass=$(yad --entry --title="需要管理员权限" --text="请输入 sudo 密码:" \
               --hide-text --width=380 2>/dev/null) || return 1
    elif have zenity; then
        pass=$(zenity --password --title="需要管理员权限" 2>/dev/null) || return 1
    fi
    [ -z "$pass" ] && return 1
    if printf '%s\n' "$pass" | sudo -S -v -p '' 2>/dev/null; then SUDO_PASS="$pass"; return 0; fi
    gui_msg error "sudo 密码错误或验证失败"
    return 1
}

root_run_script() { # $1=脚本文件路径；密码走密码通道，载荷走文件，互不干扰
    local f="$1"
    if [ "$(id -u)" = 0 ]; then bash "$f"
    elif [ -n "$SUDO_PASS" ]; then printf '%s\n' "$SUDO_PASS" | sudo -S -p '' bash "$f"
    else sudo -A bash "$f" 2>/dev/null && return 0
         ask_password && printf '%s\n' "$SUDO_PASS" | sudo -S -p '' bash "$f"
    fi
}

# ---------- 状态 ----------
get_prefix() { cat "$PREFIX_FILE" 2>/dev/null; }
status_text() {
    MP="$([ -f "$DLAGENT_CONF" ] && echo 开 || echo 关)"
    PFX="$(get_prefix)"
    GITST="$(git config --global --get-regexp '^url\..*\.insteadof$' 2>/dev/null |
             grep -q github.com/ && echo 开 || echo 关)"
    JSD="$([ -f "$JSD_FILE" ] && echo 开 || echo 关)"
    FO="$([ -f "$NOFO_FILE" ] && echo 关 || echo 开)"
}

# ---------- 备选列表 ----------
clean_url() { # 从脏文本提取最后一个 http(s) URL 并规范成 前缀/
    local u; u=$(printf '%s' "$1" | grep -Eo 'https?://[^"'"'"'|[:space:]]*' | tail -n1)
    [ -n "$u" ] || return 1
    [[ "$u" == */ ]] || u="$u/"
    printf '%s' "$u"
}
clean_url_none() {
    local u="$(printf '%s' "${1:-}" | sed 's/|.*//' | tr -d ' \r')"
    if printf '%s' "$u" | grep -Eq '^https?://[A-Za-z0-9._~:/?#@!$&()*+,;=%-]+$'; then
        printf '%s' "$u"; return 0
    fi
    return 1
}
list_init() { mkdir -p "$LIST_DIR"; touch "$LIST_FILE"
              sed -i '/[|\t]/d' "$LIST_FILE"     # 清理历史脏数据行
              grep -q . "$LIST_FILE" || printf '%s\n' "$DEFAULT_PREFIX" >>"$LIST_FILE"; }
list_add() { local u; u=$(clean_url "$1") || return 1
             grep -Fxq "$u" "$LIST_FILE" || echo "$u" >>"$LIST_FILE"; printf '%s' "$u"; }
list_del() { local u t; u=$(clean_url "$1") || return 1
             t="$LIST_FILE.tmp$$"
             grep -Fxv -e "$u" -e "${u%/}" "$LIST_FILE" >"$t" && mv "$t" "$LIST_FILE"; }

# ---------- 运行时文件 ----------
# 已带加速前缀的链接（形如 https://proxy/https://github.com/...）判断：是则原样使用，不再拼前缀
is_proxied() {
    [[ "${1:-}" =~ ^https?://[^/]+/https?:// ]]
}
# raw.githubusercontent.com -> jsdelivr CDN：/user/repo/branch/path -> /gh/user/repo/path（去掉分支段）
raw_to_jsd() { # $1=URL；转换成功输出新 URL，失败返回 1
    local rest="${1#https://raw.githubusercontent.com/}"
    [ "$rest" = "$1" ] && return 1
    local tail="${rest#*/*/}"
    [[ "$tail" == "$rest" || "$tail" != */* ]] && return 1
    printf '%s' "https://cdn.jsdelivr.net/gh/${rest%"$tail"}${tail#*/}"
}
curl_gh_body() {
cat <<'EOF'
#!/bin/bash
# 由 gh-proxy-manager 安装。前缀来自 /etc/gh-proxy/prefix，文件不存在=直连。
# github 链接下载失败或龟速(--speed-limit 20KB/s 持续 30s)时，
# 自动按 ~/.config/gh-proxy-manager/proxies 备选列表轮换，断点续传(-C -)换站续下。
url="$1"; [ "$1" = "${1#*://}" ] && { url="${@: -1}"; set -- "${@:1:$(( $# - 1 ))}"; }
# URL 兼容两种位置：显式传首个参数(直接调用)或 makepkg DLAGENT 模板 %u 在末尾(最后一个参数)
# 已带加速前缀的链接（形如 https://proxy/<原始URL>）原样透传，不重复拼接
if [[ "$url" =~ ^https?://[^/]+/https?:// ]]; then exec /usr/bin/curl "$url" "$@"; fi
if [[ "$url" == *raw.githubusercontent.com/* ]] && [ -f /etc/gh-proxy/jsdelivr ]; then
    rest="${url#https://raw.githubusercontent.com/}"
    tail="${rest#*/*/}"
    if [[ "$tail" != "$rest" && "$tail" == */* ]]; then
        exec /usr/bin/curl "https://cdn.jsdelivr.net/gh/${rest%"$tail"}${tail#*/}" "$@"
    fi
fi
case "$url" in
    *github.com/*)
        if [ -s /etc/gh-proxy/prefix ]; then
            if [ -f /etc/gh-proxy/nofailover ]; then  # 用户已关闭自动换站：只用生效站
                p="$(cat /etc/gh-proxy/prefix)"
                exec /usr/bin/curl "$@" "${p}${url}"
            fi
            # 候选=生效站优先，再备选列表，去重保序
            mapfile -t CANDS < <({ cat /etc/gh-proxy/prefix
                                   cat "$HOME/.config/gh-proxy-manager/proxies" 2>/dev/null; } |
                                 grep -E '^https?://' | awk '!seen[$0]++')
            for c in "${CANDS[@]}"; do
                /usr/bin/curl --connect-timeout 5 --speed-limit 20480 --speed-time 30 \
                              "$@" "${c}${url}" && exit 0
            done
        fi;;
esac
exec /usr/bin/curl "$url" "$@"   # 无前缀/候选全败：直连兜底
EOF
}
dlagents_body() {
cat <<'EOF'
DLAGENTS=('file::/usr/bin/curl -gqC - -o %o %u'
          'ftp::/usr/bin/curl -gqfC - --ftp-pasv --retry 3 --retry-delay 3 -o %o %u'
          'http::/usr/bin/curl -gqb "" -fLC - --retry 3 --retry-delay 3 -o %o %u'
          'https::/usr/local/bin/curl-gh -gqb "" -fLC - -o %o %u'
          'rsync::/usr/bin/rsync -zrtE --copy-links --partial --numeric-ids %u %o'
          'scp::/usr/bin/scp -C %u %o')
EOF
}

apply_all() {
    local want_mp="$1" want_git="$2" want_pfx="$3" want_jsd="${4:-}" want_fo="${5:-}" script=""
    status_text
    dlog "apply_all: 想要 mp=$want_mp git=$want_git pfx=$want_pfx jsd=$want_jsd fo=$want_fo / 当前 mp=$MP git=$GITST pfx=${PFX:-空} jsd=${JSD:-关} fo=${FO:-?}"
    if [ -z "$want_pfx" ]; then want_pfx="${PFX:-$DEFAULT_PREFIX}"; fi
    want_pfx="$(clean_url "$want_pfx")" || want_pfx="${PFX:-$DEFAULT_PREFIX}"
    if [ -z "$want_jsd" ]; then want_jsd="${JSD:-关}"; fi
    if [ -z "$want_fo" ]; then want_fo="${FO:-开}"; fi

    script="# gh-proxy-manager apply
set -e
mkdir -p /etc/gh-proxy /etc/makepkg.conf.d /usr/local/bin
printf '%s\\n' '$want_pfx' > $PREFIX_FILE.new && mv $PREFIX_FILE.new $PREFIX_FILE
chmod 644 $PREFIX_FILE
if [ '$want_jsd' = 开 ]; then : > $JSD_FILE; chmod 644 $JSD_FILE; else rm -f $JSD_FILE; fi
if [ '$want_fo' = 开 ]; then rm -f $NOFO_FILE; else : > $NOFO_FILE; chmod 644 $NOFO_FILE; fi
"
    if [ "$want_mp" = 开 ]; then
        script+="cat > /usr/local/bin/curl-gh <<'CGEOF'
$(curl_gh_body)
CGEOF
chmod 755 /usr/local/bin/curl-gh
cat > $DLAGENT_CONF <<'DLEOF'
$(dlagents_body)
DLEOF
chmod 644 $DLAGENT_CONF
"
    elif [ "$MP" = 开 ]; then
        script+="rm -f $DLAGENT_CONF
"
    fi

    ask_password || { dlog "apply 中止：未授权"; return 1; }
    local tmpf rc
    tmpf=$(mktemp /tmp/ghpm-XXXXXX.sh) || { dlog "mktemp 失败"; return 1; }
    chmod 600 "$tmpf"
    printf '%s' "$script" >"$tmpf"
    dlog "payload: $tmpf ($(wc -l <"$tmpf") 行)"
    root_run_script "$tmpf"; rc=$?
    rm -f "$tmpf"
    if [ "$rc" -ne 0 ]; then
        dlog "apply root 执行失败 rc=$rc"
        gui_msg error "应用失败（root 执行返回 $rc）"
        return 1
    fi
    sync_git_config "$want_pfx" "$want_git"
    status_text
    # 强制校验：写没写进去，以实际文件为准，杜绝静默失败
    local actual; actual="$(get_prefix)"
    if [ "$actual" != "$want_pfx" ]; then
        dlog "!! 写入未生效: 实际=$actual 期望=$want_pfx (mp=$MP git=$GITST 期望 mp=$want_mp git=$want_git)"
        gui_msg error "写入未生效！实际=$actual\n期望=$want_pfx\n请将 debug.log 反馈给开发者"
        return 1
    fi
    local want_mp_state="关" want_git_state="关"
    [ "$want_mp" = 开 ] && [ ! -f "$DLAGENT_CONF" ] && { dlog "!! DLAGENT_CONF 未写入"; gui_msg error "DLAGENT 配置未写入！"; return 1; }
    [ "$want_mp" = 关 ] && [ -f "$DLAGENT_CONF" ] && { dlog "!! DLAGENT_CONF 未删除"; gui_msg error "DLAGENT 配置未删除！"; return 1; }
    if [ "$GITST" != "$want_git" ]; then
        dlog "!! git 状态未生效: 实际=$GITST 期望=$want_git"
        gui_msg error "git 加速状态未生效！\n实际=$GITST 期望=$want_git"
        return 1
    fi
    local actual_jsd; actual_jsd="$([ -f "$JSD_FILE" ] && echo 开 || echo 关)"
    if [ "$actual_jsd" != "$want_jsd" ]; then
        dlog "!! jsdelivr 状态未生效: 实际=$actual_jsd 期望=$want_jsd"
        gui_msg error "jsdelivr 加速状态未生效！\n实际=$actual_jsd 期望=$want_jsd"
        return 1
    fi
    local actual_fo="$([ -f "$NOFO_FILE" ] && echo 关 || echo 开)"
    if [ "$actual_fo" != "$want_fo" ]; then
        dlog "!! failover 状态未生效: 实际=$actual_fo 期望=$want_fo"
        gui_msg error "自动换站状态未生效！\n实际=$actual_fo 期望=$want_fo"
        return 1
    fi
    dlog "apply 成功: mp=$MP git=$GITST pfx=$PFX jsd=$JSD fo=$FO"
    return 0
}

sync_git_config() {
    local new="$1" enable="$2" key val cur
    # git config --list 输出是 key=value（等号分隔），按 = 切分
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        key="${line%%=*}"; val="${line#*=}"
        [[ "$key" == *.insteadof ]] || continue
        [[ "$val" == "$GIT_URL_KEY_HOST" ]] || continue
        cur="${key#url.}"; cur="${cur%.insteadof}"
        if [ "$enable" != 开 ] || [ "$cur" != "$new$GIT_URL_KEY_HOST" ]; then
            dlog "git 清理: $key"
            git config --global --unset-all "url.${cur}.insteadOf" 2>/dev/null
            git config --global --remove-section "url.${cur}" 2>/dev/null
        fi
    done < <(git config --global --list 2>/dev/null)
    if [ "$enable" = 开 ]; then
        git config --global "url.${new}${GIT_URL_KEY_HOST}.insteadOf" "$GIT_URL_KEY_HOST"
    fi
    return 0
}

# ---------- GUI 公共 ----------
# 注意: 本机 yad 版本无 --info/--error 子命令，弹窗用通用文本窗实现
gui_msg() {
    local r
    if have yad; then
        if [ "$1" = error ]; then
            yad --text="<b>⚠ 出错</b>\n$2" --title="提示" --width=430 --height=180 \
                --button="确 定:0" 2>/dev/null; r=$?
        else
            yad --text="$2" --title="提示" --width=430 --height=180 \
                --button="确 定:0" 2>/dev/null; r=$?
        fi
    else
        zenity "--$1" --text="$2" 2>/dev/null; r=$?
    fi
    [ "$r" -ne 0 ] && dlog "弹窗异常: gui_msg $1 rc=$r"
    return 0
}

# ---------- 测速探针 ----------
# 用 release 文件实测（694KB）：makepkg/yay 的真实下载场景就是 release，
# 只测 raw README 会漏判"raw 可用但 release 404/限速"的坏站
TEST_URL="https://github.com/sharkdp/hyperfine/releases/download/v1.18.0/hyperfine-v1.18.0-x86_64-unknown-linux-musl.tar.gz"
test_probe() { # $1=前缀; 输出 "HTTP码 平均速度B/s"
    curl -sL --connect-timeout 5 -m 40 -o /dev/null \
         -w '%{http_code} %{speed_download}' "${1}${TEST_URL}" 2>/dev/null
}
fmt_verdict() { # $1=HTTP码 $2=速度B/s
    case "$1" in
        200|206) printf '✓ 可用 · %d KB/s' "$(($2/1024))";;
        *)       printf '✗ 不可用(HTTP %s)' "$1";;
    esac
}

do_test_gui() {
    status_text
    local out verdict
    out=$(test_probe "$PFX")
    verdict=$(fmt_verdict $out)
    dlog "test $PFX -> $out"
    gui_msg info "测试(下载 release 文件实测):\n$verdict\n地址: $PFX"
}

# ---------- GUI: yad 主窗 ----------
yad_main() {
    status_text
    local mp_ch=FALSE g_ch=FALSE jsd_ch=FALSE fo_ch=FALSE
    [ "${MP:-关}" = 开 ] && mp_ch=TRUE
    [ "${GITST:-关}" = 开 ] && g_ch=TRUE
    [ "${JSD:-关}" = 开 ] && jsd_ch=TRUE
    [ "${FO:-开}" = 开 ] && fo_ch=TRUE
    yad --form --title="GitHub 下载加速管理" --width=560 \
        --separator="|" \
        --field="启用 yay/makepkg 下载加速:CHK" \
        --field="启用 git clone 加速:CHK" \
        --field="raw.githubusercontent.com启用jsdelivr的cdn加速:CHK" \
        --field="失败/龟速时自动换备选站:CHK" \
        --field="加速地址(前缀，自动补 /):" \
        --button="备选地址(含测试)…:4" --button="应 用:0" --button="退 出:1" \
        "$mp_ch" "$g_ch" "$jsd_ch" "$fo_ch" "${PFX:-$DEFAULT_PREFIX}"
}

parse_form() { # $1=raw；设 FORM_MP/FORM_GIT/FORM_JSD/FORM_FO/FORM_PFX；失败返回 1
    local raw="$1"
    local re='^([Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee])([^A-Za-z]*)([Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee])([^A-Za-z]*)([Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee])([^A-Za-z]*)([Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee])(.*)$'
    if [[ "$raw" =~ $re ]]; then
        # yad 输出 TRUE/FALSE（全大写），统一按首字符判断
        case "${BASH_REMATCH[1]}" in T*|t*) FORM_MP=开;; *) FORM_MP=关;; esac
        case "${BASH_REMATCH[3]}" in T*|t*) FORM_GIT=开;; *) FORM_GIT=关;; esac
        case "${BASH_REMATCH[5]}" in T*|t*) FORM_JSD=开;; *) FORM_JSD=关;; esac
        case "${BASH_REMATCH[7]}" in T*|t*) FORM_FO=开;; *) FORM_FO=关;; esac
        FORM_PFX="${BASH_REMATCH[8]}"
        FORM_PFX="${FORM_PFX#[|:]^I}"
        return 0
    fi
    return 1
}

yad_loop() {
    local vals yrc parsed
    while true; do
        vals=$(yad_main); yrc=$?
        dlog "主窗 rc=$yrc 输出=[$vals]"
        case "$yrc" in
            2) do_test_gui ;;
            4) proxy_manager ;;
            0) status_text; parsed=关
               if parse_form "$vals"; then
                   apply_all "$FORM_MP" "$FORM_GIT" "$FORM_PFX" "$FORM_JSD" "$FORM_FO" || continue
                   parsed=开
               elif [ -n "$vals" ]; then
                   # 兜底：解析不出布尔值时不动开关，只按输入框地址更新（若可提取）
                   dlog "表单解析失败: [$vals]"
                   if FORM_PFX="$(clean_url "$vals")"; then
                       apply_all "$MP" "$GITST" "$FORM_PFX" || continue
                       gui_msg info "开关状态保持不变(数据异常)，仅更新了地址。\n完整调试: debug.log"
                       parsed=开
                   else
                       gui_msg error "界面数据格式异常，本次已取消，设置未被修改。"
                       continue
                   fi
               else
                   dlog "应用收到空输出"
                   gui_msg error "未读取到界面数据，设置未被修改。"
                   continue
               fi
               [ "$parsed" = 开 ] && gui_msg info "已应用 ✓\nyay/makepkg 加速:$MP\ngit 加速:$GITST\nraw 走 jsdelivr:$JSD\n自动换站:$FO\n生效地址:$(get_prefix)" ;;
            1|252) exit 0 ;;
            *) dlog "未知按钮码 $yrc"; exit 0 ;;
        esac
    done
}

# ---------- 备选管理 ----------
RESULT_FILE="$LIST_DIR/results"     # 测试状态缓存: 地址<TAB>状态

test_one() {
    local p="$1" out verdict
    out=$(test_probe "$p")
    verdict=$(fmt_verdict $out)
    mkdir -p "$LIST_DIR"
    grep -v "^${p}	" "$RESULT_FILE" 2>/dev/null >"$RESULT_FILE.tmp$$"
    printf '%s\t%s\n' "$p" "$verdict" >>"$RESULT_FILE.tmp$$"
    mv "$RESULT_FILE.tmp$$" "$RESULT_FILE"
    dlog "test $p -> $out"
}
get_result() { awk -F'\t' -v u="$1" '$1==u{print $2}' "$RESULT_FILE" 2>/dev/null; }

proxy_manager() {
    # 只读清单展示；交互走已被验证可靠的 yad --entry 输入框
    # 测试提供「全部」一键模式，无需任何输入
    refresh_list() {
        status_text; list_init
        local i=0 addr st
        ADDR_LIST=()
        TXT_OUT=""
        while IFS= read -r addr; do
            [ -n "$addr" ] || continue
            i=$((i+1)); ADDR_LIST+=("$addr")
            st="$(get_result "$addr")"
            [ "$addr" = "$(get_prefix)" ] && st="★ 当前生效${st:+ · $st}"
            TXT_OUT+="[$i] $addr    ${st:-未测试}"$'\n'
        done < "$LIST_FILE"
        N_TOTAL=$i
    }

    pick_num() { # $1=提示语；输出一个地址或空
        refresh_list
        local ans n u=""
        ans=$(yad --entry --title="$1" \
              --text="$TXT_OUT\n$1   (编号范围: 1-$N_TOTAL)") || return 1
        n="${ans//[[:space:]]/}"
        [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le "$N_TOTAL" ] && echo "${ADDR_LIST[$((n-1))]}"
    }
    pick_nums() { # 多个编号，逗号分隔 -> 一行一个地址；无效项跳过并提示
        refresh_list
        local ans n out="" bad=""
        ans=$(yad --entry --title="批量测试" \
              --text="$TXT_OUT\n输入要测试的编号，多个用逗号分隔(如 1,3)   (编号范围: 1-$N_TOTAL)") || return 1
        ans="${ans//，/,}"; ans="${ans// /}"
        IFS=',' read -ra ns <<<"$ans"
        for n in "${ns[@]}"; do
            [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le "$N_TOTAL" ] &&
                out+="${ADDR_LIST[$((n-1))]}"$'\n' || bad+="[$n] "
        done
        [ -n "$bad" ] && gui_msg error "以下编号无效已忽略: $bad"
        [ -n "$out" ] && printf '%s' "$out"
    }

    bulk_test() { # $1=一行一个待测地址
        local total u cnt=0 resf cpid out verdict
        total=$(grep -c . <<<"$1"); cnt=0
        { while IFS= read -r u; do
              [ -n "$u" ] || continue
              cnt=$((cnt+1))
              resf=$(mktemp /tmp/ghpm-t-XXXXXX)
              ( test_probe "$u" ) >"$resf" &
              cpid=$!
              base=$(( (cnt-1)*100/total ))
              while kill -0 "$cpid" 2>/dev/null; do
                  echo "#[$cnt/$total] 正在测试: $u"
                  echo $((base+1)); sleep 0.35
              done
              wait "$cpid" 2>/dev/null
              out=$(cat "$resf"); rm -f "$resf"
              verdict=$(fmt_verdict $out)
              grep -v "^${u}	" "$RESULT_FILE" 2>/dev/null >"$RESULT_FILE.tmp$$"
              printf '%s\t%s\n' "$u" "$verdict" >>"$RESULT_FILE.tmp$$"
              mv "$RESULT_FILE.tmp$$" "$RESULT_FILE"
              dlog "test[$cnt/$total] $u -> $out"
          done <<<"$1"
          echo "#测试完成 ✓"; echo 100
        } | yad --progress --title="连通性测试" --width=470 --auto-close >/dev/null 2>&1
    }

    while true; do
        local ADDR_LIST=() N_TOTAL=0 body TXT_OUT=""
        refresh_list
        # 列表用真实换行直接输出（不要套 span，Pango 会吞换行导致列表不显示）
        local listed="${TXT_OUT%$'\n'}"
        body="<b>备选代理地址（当前生效地址带★）</b>\n\n$listed\n\n―――――――――――――\n"
        yad --title="备选代理地址管理" --width=780 --height=460 \
            --text="$body\n<b>操作提示</b>：\n ・ 「测 试(全 部)」一键测所有；「测 试(指定编号)」在下一步输入编号，多个用逗号分隔（如 1,3）\n ・ 「删 除」「设为生效」按输入编号执行，每次一个编号\n\n当前生效地址: $(get_prefix)" \
            --button="测 试(全 部):5" --button="测 试(指定编号):6" \
            --button="添 加:2" --button="删 除:3" --button="变更代理:0" --button="关 闭:1"
        rc=$?
        dlog "管理窗口 rc=$rc"
        case "$rc" in
            5) bulk_test "$(cat "$LIST_FILE")" ;;
            6) nums=$(pick_nums); [ -z "$nums" ] && continue; bulk_test "$nums" ;;
            2) nu=$(yad --entry --title="添加备选代理" --text="输入代理前缀 URL:" \
                    --entry-text="https://" --width=460) || continue
               new_u=$(list_add "$nu") && gui_msg info "已添加: $new_u" ||
                   gui_msg error "无效地址: $nu" ;;
            3) u=$(pick_num "输入要删除的编号") || continue
               if [ -z "$u" ]; then gui_msg error "无效编号"; continue; fi
               if [ "$u" = "$(get_prefix)" ]; then
                   gui_msg error "该地址当前生效，请先切换其他地址后再删除:\n$u"
               else
                   list_del "$u" && gui_msg info "已删除:\n$u"
               fi ;;
            0) u=$(pick_num "输入要设为生效的编号") || continue
               [ -z "$u" ] && { gui_msg error "无效编号"; continue; }
               status_text
               apply_all "${MP:-关}" "${GITST:-关}" "$u" &&
                   gui_msg info "已切换生效地址:\n$(get_prefix)" ;;
            *) return ;;
        esac
    done
}

# ---------- zenity 后备 ----------
# 注意: zenity 4.x 的 --forms 没有 --add-checkbox（会报 This option is not available
# 并以 255 退出，旧版这里 stderr 被丢弃导致"点了没反应/闪退"）。开关改用 --add-combo
# 模拟，当前状态排第一项即为默认值；仅 yad 缺席时才走这里。
zenity_ui() {
    local zerr="$LIST_DIR/zenity.err" ans rc
    while true; do
        status_text; list_init
        ans=$(zenity --forms --title="GitHub 下载加速管理" --width=520 \
            --text "各开关已按当前状态预选；地址留空则保持当前值" \
            --add-combo="启用 yay/makepkg 下载加速" --combo-values="$([ "${MP:-关}" = 开 ] && echo '开|关' || echo '关|开')" \
            --add-combo="启用 git clone 加速"      --combo-values="$([ "${GITST:-关}" = 开 ] && echo '开|关' || echo '关|开')" \
            --add-combo="raw 走 jsdelivr CDN"      --combo-values="$([ "${JSD:-关}" = 开 ] && echo '开|关' || echo '关|开')" \
            --add-combo="失败/龟速自动换站"         --combo-values="$([ "${FO:-开}" = 开 ] && echo '开|关' || echo '关|开')" \
            --add-entry="加速地址(前缀，留空不变):" \
            --separator="|" 2>"$zerr") || {
                rc=$?
                if [ "$rc" = 255 ] || grep -qiE 'not available|unknown option' "$zerr" 2>/dev/null; then
                    dlog "zenity 界面失败 rc=$rc: $(tr '\n' ' ' <"$zerr" 2>/dev/null | head -c 200)"
                    echo "✗ 图形界面无法启动（zenity 返回 $rc）" >&2
                    echo "  建议安装 yad（图形界面推荐），或改用命令行：" >&2
                    echo "    gh-proxy-manager status | on | off | url <前缀> | git-on | git-off | failover on|off" >&2
                    exit 1
                fi
                exit 0   # 用户取消/关窗，正常退出
            }
        dlog "zenity 输出=[$ans]"
        # combo 直接输出「开」/「关」；地址留空由 apply_all 兜底沿用当前值
        IFS='|' read -r c1 c2 c3 c4 pfx_in <<<"$ans"
        apply_all "$c1" "$c2" "$pfx_in" "$c3" "$c4" || continue
        gui_msg info "已应用 ✓ 当前地址: $(get_prefix)\n自动换站: ${FO:-?}"
    done
}

# ---------- CLI ----------
cli() {
    case "${1:-status}" in
        on)      status_text; apply_all 开 "$GITST" "";;
        off)     status_text; apply_all 关 "$GITST" "";;
        url)     status_text; apply_all "$MP" "$GITST" "${2:?用法: url <前缀>}";;
        git-on)  status_text; apply_all "$MP" 开 "";;
        git-off) status_text; apply_all "$MP" 关 "";;
        add)     list_init; list_add "${2:?用法: add <URL>}" >/dev/null && echo 已添加;;
        del)     list_init; list_del "${2:?用法: del <URL>}" && echo 已删除;;
        use)     status_text; apply_all "$MP" "$GITST" "${2:?用法: use <URL>}";;
        failover) status_text
                  case "${2:-}" in
                      on)  apply_all "$MP" "$GITST" "" "${JSD:-关}" 开;;
                      off) apply_all "$MP" "$GITST" "" "${JSD:-关}" 关;;
                      *)   echo "用法: $0 failover on|off"; exit 1;;
                  esac;;
        proxies) list_init; cat "$LIST_FILE";;
        get)     status_text
                 u="${2:?用法: gh-proxy-manager get <url> [curl选项...]}"
                 target="$(clean_url_none "$u")" || { echo "✗ 不是有效的 http(s) URL: [$u]" >&2; exit 1; }
                 if is_proxied "$target"; then
                     dlog "get 已带加速前缀，原样透传: $target"
                 else
                     case "$target" in
                          *github.com/*) [ -n "${PFX:-}" ] && target="${PFX}${target}";;
                          *raw.githubusercontent.com/*)
                              if [ "${JSD:-}" = 开 ] && target="$(raw_to_jsd "$target")"; then :; else
                                  [ -n "${PFX:-}" ] && target="${PFX}${target}"
                              fi;;
                      esac
                     dlog "get ${PFX:-无前缀}$target"
                 fi
                 exec curl -L --fail --retry 3 -O "${@:3}" "$target";;
        status)  status_text; list_init
                 echo "makepkg/yay 加速: $MP   地址: ${PFX:-—}"
                 echo "git clone   加速: $GITST   raw走jsdelivr: ${JSD:-关}   自动换站: ${FO:-?}"; echo "--- 备选 ---"; cat "$LIST_FILE";;
        test)    status_text; fmt_verdict $(test_probe "$PFX"); echo;;
        log)     cat "$LOG_FILE" 2>/dev/null;;
        *)       echo "子命令: on|off|url <前缀>|git-on|git-off|failover on|off|add <URL>|del <URL>|use <URL>|proxies|get <url>|status|test|log";;
    esac
}

case "${1:-gui}" in
    gui) if have yad; then yad_loop
         elif have zenity; then zenity_ui
         else echo "未检测到图形界面组件（yad/zenity），改用命令行模式：" >&2
              cli status; fi;;
    *)   cli "$@";;
esac
